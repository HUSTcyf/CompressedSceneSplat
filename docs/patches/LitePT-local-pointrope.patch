+def _load_kernels():
+    # The compiled pointrope CUDA extension is installed as a top-level
+    # "pointrope" module (see setup.py). When LitePT/libs is on sys.path the
+    # directory package shadows it, so load the extension .so directly.
+    candidates = []
+    for p in sys.path:
+        if not p:
+            continue
+        cand = os.path.join(p, "pointrope.cpython-311-x86_64-linux-gnu.so")
+        if os.path.exists(cand):
+            candidates.append(cand)
+    if not candidates:
+        raise RuntimeError("pointrope compiled extension not found")
+    spec = importlib.util.spec_from_file_location("pointrope", candidates[0])
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules["pointrope"] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+_kernels = _load_kernels()
 
 
